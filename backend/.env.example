# Copy to .env and fill in. Everything is optional: the app runs without keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# per-zone resident channels, e.g. z1:-1001234567890,z3:-1009876543210
TELEGRAM_ZONE_CHATS=
CITY_NAME=Jaipur
CITY_LAT=26.8800
CITY_LON=75.8000
DATAGOVIN_API_KEY=
CPCB_CITY=Jaipur
TOMTOM_API_KEY=
CORS_ORIGINS=http://localhost:3000
HISTORY_DAYS=3
TICK_SECONDS=5
WINDOW_MIN=30
LINK_WINDOW_MIN=45
USE_REAL_APIS=true
